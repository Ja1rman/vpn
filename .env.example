# Names used by deploy.yml. Store real values in GitHub production Secrets.
# This is a list of names, not a ready-to-source dotenv file with JSON values.
VPN_DEPLOY_ENABLED=false
VPN_MONITORING_USERNAME=admin
VPN_MONITORING_PASSWORD=
VPN_SSH_PASSWORDS_JSON=
VPN_SSH_KNOWN_HOSTS=
VPN_OUTBOUNDS_JSON=
VPN_MONITORING_TLS_JSON=
# Optional complete private Alertmanager YAML; empty means the web-only template.
VPN_ALERTMANAGER_CONFIG=
