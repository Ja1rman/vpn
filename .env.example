# Names used by deploy.yml. Store real values in GitHub production Secrets.
# This is a list of names, not a ready-to-source dotenv file with JSON values.
VPN_DEPLOY_ENABLED=false
VPN_MONITORING_USERNAME=admin
VPN_MONITORING_PASSWORD=
VPN_SSH_PASSWORDS_JSON=
VPN_SSH_KNOWN_HOSTS=
VPN_OUTBOUNDS_JSON=
VPN_MONITORING_TLS_JSON=
# Optional complete private Alertmanager YAML; empty means the web-only template.
VPN_ALERTMANAGER_CONFIG=
# Optional Telegram MTProto FakeTLS secret for the manual mtproto component.
VPN_MTPROTO_SECRET=
# Credentials for the independent authenticated Telegram SOCKS listener.
VPN_TELEGRAM_SOCKS_USERNAME=
VPN_TELEGRAM_SOCKS_PASSWORD=
# Optional physical laptop interface for anonymous native Telegram proof.
VPN_TELEGRAM_PROBE_INTERFACE=

# Required private network topology JSON: named deployment addresses and ports.
VPN_ENDPOINTS_JSON=

# Optional individual endpoint overrides. Leave empty to use VPN_ENDPOINTS_JSON
# or the ignored .local/network-env.json registry; never commit real values.
VPN_ALERTMANAGER_PORT=
VPN_ALERTMANAGER_URL=
VPN_AUTO_API_PORT=
VPN_AUTO_REALITY_PORT=
VPN_AUTO_SNIFF_PORT=
VPN_AUTO_SOURCE_ADDRESS=
VPN_AUTO_SOURCE_IP=
VPN_AUTO_SUBSCRIPTION_PORT=
VPN_AUTO_TLS_PORT=
# Published Auto access socket; forwards to VPN_AUTO_TLS_PORT without replacing it.
VPN_AUTO_TLS_PUBLIC_PORT=
VPN_BALANCER_API_PORT=
VPN_BALANCER_SOCKS_PORT=
VPN_BIND_IP=
VPN_BIND_IPV6_IP=
VPN_BLACKBOX_PORT=
VPN_COMPAT_VLESS_PORT=
VPN_DNS_ADDRESS=
VPN_DNS_PORT=
VPN_ENTRY_ADDRESS=
VPN_EXIT_HYSTERIA_PORT=
VPN_EXIT_RESERVE_PORT=
VPN_EXIT_TLS_PORT=
VPN_FAILOVER_SOCKS_PORT=
VPN_GRAFANA_PORT=
VPN_GRAFANA_URL=
VPN_HTTP_LEGACY_PORT=
VPN_HTTP_PRIMARY_PORT=
VPN_HTTP_SECONDARY_PORT=
VPN_HTTP_SOCKS_PORT=
VPN_LOCAL_SOCKS_BRIDGE_PORT=
VPN_LOOPBACK_IP=
VPN_MONITORING_HTTPS_PORT=
VPN_MONITORING_HTTP_PORT=
VPN_MTPROTO_PORT=
VPN_MTPROTO_PUBLIC_PORT=
# Additional secure DD transport, preserving the original FakeTLS endpoint.
VPN_MTPROTO_DD_PORT=
# Official Telegram WEB: DNS hostname, private loopback listeners and ACME listener.
VPN_WEB_PROXY_ADDRESS=
VPN_WEB_PROXY_PORT=
VPN_WEB_PROXY_ADMIN_PORT=
VPN_WEB_ACME_PORT=
# Optional protected JSON for restoring the stable WEB key, path and signing key.
VPN_WEB_PROXY_CREDENTIALS_JSON=
VPN_NEW_EXIT_ADDRESS=
VPN_NL_ADDRESS=
VPN_NL_RELAY_TLS_PORT=
VPN_NL_RELAY_VLESS_PORT=
VPN_NODE_EXPORTER_PORT=
VPN_NODE_PORT=
VPN_PRIMARY_EXIT_ADDRESS=
VPN_PRIMARY_TLS_PORT=
VPN_PRIMARY_VLESS_PORT=
VPN_PROMETHEUS_PORT=
VPN_PROMETHEUS_URL=
VPN_SMTP_PORT=
VPN_SMTP_STARTTLS_PORT=
VPN_SSH_PORT=
VPN_SS_PORT=
VPN_STANDARD_TLS_PORT=
VPN_SUBSCRIPTION_PORT=
VPN_TELEGRAM_SOCKS_PORT=
# Optional additional SOCKS access socket; not required by the Auto component.
VPN_TELEGRAM_SOCKS_PUBLIC_PORT=
VPN_TEST_ADDRESS_A=
VPN_TEST_ADDRESS_B=
VPN_TEST_ADDRESS_C=
VPN_TEST_ADDRESS_D=
VPN_TEST_ADDRESS_E=
VPN_TEST_API_PORT=
VPN_TEST_CANARY_PORT=
VPN_TEST_DNS_ADDRESS_A=
VPN_TEST_DNS_ADDRESS_B=
VPN_TEST_DNS_ADDRESS_C=
VPN_TEST_EXIT_A_PORT=
VPN_TEST_EXIT_B_PORT=
VPN_TEST_POOL_PORT=
VPN_TEST_ROUTE_ADDRESS=
VPN_TEST_VLESS_PORT=
VPN_THIRD_EXIT_ADDRESS=
VPN_THIRD_TLS_PORT=
VPN_THIRD_VLESS_PORT=
VPN_VLESS_AUTH_PORT=
VPN_VLESS_NATIVE_PORT=
VPN_WEB_HTTPS_PORT=
VPN_WEB_HTTP_PORT=
VPN_WIREGUARD_CLIENT_ADDRESS=
VPN_WIREGUARD_LEGACY_PORT=
VPN_WIREGUARD_PRIMARY_PORT=
VPN_XUI_API_PORT=
VPN_XUI_PANEL_PORT=

# Independent Netherlands Telegram reserve backends
VPN_NL_TELEGRAM_SOCKS_PORT=
VPN_NL_MTPROTO_DD_PORT=
VPN_NL_MTPROTO_EE_PORT=
# Actual NIC destination behind any cloud NAT, distinct from public client address.
VPN_ENTRY_INGRESS_IP=
VPN_ENTRY_INGRESS_INTERFACE=
VPN_ENTRY_TELEGRAM_MUX_PORT=
VPN_NL_INGRESS_IP=
VPN_NL_INGRESS_INTERFACE=
VPN_NL_TELEGRAM_MUX_PORT=
VPN_TELEGRAM_RESERVE_CREDENTIALS_JSON=
VPN_NL_TELEGRAM_PUBLIC_PORT=
VPN_TELEGRAM_VERIFY_HTTPS_PORT=
