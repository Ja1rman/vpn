{
  "entry": {
    "name": "entry",
    "address": "${VPN_ENTRY_ADDRESS}",
    "user": "marat",
    "interface": "eth0",
    "network_budget_mbps": 1000,
    "vpn_probe_ports": [
      "${VPN_VLESS_NATIVE_PORT}",
      "${VPN_COMPAT_VLESS_PORT}",
      "${VPN_HTTP_LEGACY_PORT}",
      "${VPN_MTPROTO_PORT}",
      "${VPN_MTPROTO_PUBLIC_PORT}",
      "${VPN_TELEGRAM_SOCKS_PORT}"
    ]
  },
  "nodes": [
    {
      "name": "breeze-reef",
      "address": "${VPN_NL_ADDRESS}",
      "user": "root",
      "interface": "eth0",
      "network_budget_mbps": 1000,
      "outbounds": [
        ".local/outbounds/breeze-reef-vless.json",
        ".local/outbounds/breeze-reef-hysteria.json",
        ".local/outbounds/breeze-reef-tcp.json"
      ],
      "outbound_tags": {
        ".local/outbounds/breeze-reef-hysteria.json": "pool-breeze-reef-hysteria-v2",
        ".local/outbounds/breeze-reef-tcp.json": "pool-breeze-reef-tcp-v1"
      },
      "vpn_probe_ports": [
        "${VPN_EXIT_TLS_PORT}",
        "${VPN_EXIT_RESERVE_PORT}"
      ]
    }
  ],
  "balancer": {
    "strategy": "priority",
    "socks_port": "${VPN_BALANCER_SOCKS_PORT}",
    "api_port": "${VPN_BALANCER_API_PORT}",
    "probe_interval": "10s",
    "probe_url": "https://www.google.com/generate_204",
    "priority_order": [
      "pool-breeze-reef-0",
      "pool-breeze-reef-tcp-v1"
    ],
    "reserve_outbounds": [
      {
        "name": "ihor",
        "file": ".local/outbounds/legacy-reserve-ihor.json"
      },
      {
        "name": "srv-41969",
        "file": ".local/outbounds/legacy-reserve-srv-41969.json"
      }
    ]
  },
  "failover": {
    "direct_ru_ipv4": "${VPN_ENTRY_ADDRESS}",
    "egresses": [
      {
        "name": "ihor",
        "address": "${VPN_PRIMARY_EXIT_ADDRESS}",
        "source": "main",
        "tag": "ihor-vless-1-5jj7e3veas"
      },
      {
        "name": "breeze-reef",
        "address": "${VPN_NL_ADDRESS}",
        "source": "legacy",
        "tag": "pool-breeze-reef-tcp-v1"
      },
      {
        "name": "srv-41969",
        "address": "${VPN_THIRD_EXIT_ADDRESS}",
        "source": "main",
        "tag": "srv-41969-vless-t361oghssd"
      }
    ],
    "probe_urls": [
      "https://www.google.com/generate_204",
      "https://cp.cloudflare.com/generate_204"
    ]
  },
  "monitoring": {
    "node_port": "${VPN_NODE_PORT}",
    "prometheus_port": "${VPN_PROMETHEUS_PORT}",
    "grafana_port": "${VPN_GRAFANA_PORT}",
    "alertmanager_port": "${VPN_ALERTMANAGER_PORT}",
    "blackbox_port": "${VPN_BLACKBOX_PORT}"
  }
}
