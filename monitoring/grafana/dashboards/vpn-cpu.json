{
  "uid": "vpn-cpu",
  "title": "VPN — CPU и системная нагрузка",
  "description": "Загрузка процессора, отдельные ядра, режимы CPU, очередь процессов и pressure. Все проценты CPU нормированы на количество ядер.",
  "tags": [
    "vpn",
    "node-exporter"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "timezone": "browser",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "links": [
    {
      "title": "Обзор",
      "type": "link",
      "url": "/grafana/d/vpn-infrastructure/",
