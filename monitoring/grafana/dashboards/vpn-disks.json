    {
      "id": 2,
      "title": "Файловые системы: занято",
      "description": "Использование с учётом места, доступного непривилегированному пользователю.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - node_filesystem_avail_bytes{job=\"node\",host=~\"$host\",fstype!~\"tmpfs|devtmpfs|overlay|squashfs|nsfs|proc|sysfs|cgroup2?\",mountpoint=~\"$mountpoint\"} / node_filesystem_size_bytes{job=\"node\",host=~\"$host\",fstype!~\"tmpfs|devtmpfs|overlay|squashfs|nsfs|proc|sysfs|cgroup2?\",mountpoint=~\"$mountpoint\"})",
          "legendFormat": "{{host}} · {{mountpoint}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "color": {
            "mode": "thresholds"
          },
          "decimals": 1,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "wideLayout": true
      }
    },
