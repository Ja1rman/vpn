    {
      "id": 16,
      "title": "Memory pressure",
      "description": "Linux PSI: some — простаивает хотя бы одна задача, full — все активные задачи.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 39,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * rate(node_pressure_memory_waiting_seconds_total{job=\"node\",host=~\"$host\"}[$__rate_interval])",
          "legendFormat": "{{host}} · some",
          "range": true
        },
        {
          "refId": "B",
          "expr": "100 * rate(node_pressure_memory_stalled_seconds_total{job=\"node\",host=~\"$host\"}[$__rate_interval])",
