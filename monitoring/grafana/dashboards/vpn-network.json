  "templating": {
    "list": [
      {
        "name": "host",
        "label": "Сервер",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(up{job=\"node\"}, host)",
        "refresh": 1,
        "sort": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "interface",
        "label": "Интерфейс",
        "type": "query",
        "datasource": {
