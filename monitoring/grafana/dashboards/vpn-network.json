    {
      "id": 9,
      "title": "Использование бюджета RX+TX",
      "description": "Бюджет задаётся в inventory/hosts.json; это сумма RX+TX.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * ((8 * rate(node_network_receive_bytes_total{job=\"node\",host=~\"$host\",device=~\"$interface\",device!~\"lo|veth.*|docker.*|br-.*\"}[$__rate_interval])) + (8 * rate(node_network_transmit_bytes_total{job=\"node\",host=~\"$host\",device=~\"$interface\",device!~\"lo|veth.*|docker.*|br-.*\"}[$__rate_interval]))) / on(host,device) group_left() vpn_network_capacity_bits",
          "legendFormat": "{{host}} · {{device}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "decimals": 1,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 1,
            "fillOpacity": 10,
            "spanNulls": false,
            "showPoints": "never",
            "axisPlacement": "auto",
            "axisBorderShow": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
