    {
      "id": 9,
      "title": "Использование бюджета канала RX+TX, %",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * 8 * (rate(node_network_receive_bytes_total{host=~\"$host\",device=~\"$interface\"}[$__rate_interval]) + rate(node_network_transmit_bytes_total{host=~\"$host\",device=~\"$interface\"}[$__rate_interval])) / on(host,device) group_left() vpn_network_capacity_bits",
          "legendFormat": "{{host}} {{device}} {{mountpoint}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 85
              },
              {
                "color": "red",
                "value": 95
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 10,
      "title": "Сетевые ошибки и потери",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(node_network_receive_drop_total{host=~\"$host\",device=~\"$interface\"}[$__rate_interval]) + rate(node_network_transmit_drop_total{host=~\"$host\",device=~\"$interface\"}[$__rate_interval]) + rate(node_network_receive_errs_total{host=~\"$host\",device=~\"$interface\"}[$__rate_interval]) + rate(node_network_transmit_errs_total{host=~\"$host\",device=~\"$interface\"}[$__rate_interval])",
          "legendFormat": "{{host}} {{device}} {{mountpoint}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 85
              },
              {
                "color": "red",
                "value": 95
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
