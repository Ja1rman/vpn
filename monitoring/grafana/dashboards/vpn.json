      "targets": [
        {
          "refId": "A",
          "expr": "8 * rate(node_network_transmit_bytes_total{host=~\"$host\",device=~\"$interface\"}[$__rate_interval])",
          "legendFormat": "{{host}} {{device}} {{mountpoint}}"
